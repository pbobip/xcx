<view class="page">
  <view class="card list">
    <view class="list-row" hover-class="row-hover" bindtap="onPlaceholder" data-message="账号注销与数据请求待接入后台">
      <view class="icon i-shield"></view>
      <view class="grow">
        <view class="h3">账号与安全</view>
        <view class="p">微信授权、注销与数据请求</view>
      </view>
      <view class="icon i-chevron"></view>
    </view>
    <view class="list-row" hover-class="row-hover" bindtap="toggleNotify">
      <view class="icon i-message"></view>
      <view class="grow">
        <view class="h3">消息通知</view>
        <view class="p">接收订单与售后通知</view>
      </view>
      <view class="switch {{notifyOn ? 'on' : ''}}" catchtap="toggleNotify"></view>
    </view>
  </view>

  <view class="card list">
    <view class="list-row" hover-class="row-hover" bindtap="onPlaceholder" data-message="意见反馈入口待接入">
      <view class="icon i-message"></view>
      <view class="grow">
        <view class="h3">意见反馈</view>
        <view class="p">提交产品建议</view>
      </view>
      <view class="icon i-chevron"></view>
    </view>
    <view class="list-row" hover-class="row-hover" bindtap="onPlaceholder" data-message="正式用户协议待配置">
      <view class="icon i-order"></view>
      <view class="grow">
        <view class="h3">用户协议</view>
        <view class="p">当前生效版本</view>
      </view>
      <view class="icon i-chevron"></view>
    </view>
    <view class="list-row" hover-class="row-hover" bindtap="onPlaceholder" data-message="正式隐私政策待配置">
      <view class="icon i-shield"></view>
      <view class="grow">
        <view class="h3">隐私政策</view>
        <view class="p">查看信息处理规则</view>
      </view>
      <view class="icon i-chevron"></view>
    </view>
    <view class="list-row" hover-class="row-hover" bindtap="onPlaceholder" data-message="爆爆熊电竞原型版">
      <view class="icon i-user"></view>
      <view class="grow">
        <view class="h3">关于我们</view>
        <view class="p">品牌与客服信息</view>
      </view>
      <view class="icon i-chevron"></view>
    </view>
  </view>

  <view class="btn btn-danger" style="width:100%" hover-class="btn-hover" bindtap="openLogout">退出登录</view>
</view>
<bbx-toast id="toast" />

<view class="modal-backdrop {{logoutOpen ? 'open' : ''}}" bindtap="closeLogout" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <view class="h2">确认退出登录？</view>
    <view class="p">退出不会删除依法应保存的订单；再次使用支付功能时需要重新授权。</view>
    <view class="row">
      <view class="btn btn-secondary" hover-class="btn-hover" bindtap="closeLogout">取消</view>
      <view class="btn btn-danger" hover-class="btn-hover" bindtap="confirmLogout">退出登录</view>
    </view>
  </view>
</view>
