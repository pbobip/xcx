<view class="page tab-page">
  <view class="page-toolbar">
    <view class="grow"></view>
    <care-btn />
    <view class="toolbar-action icon-only" hover-class="nav-action-hover" bindtap="onSearch" aria-label="搜索">
      <view class="icon i-search"></view>
    </view>
  </view>

  <view class="card pad state-card" wx:if="{{loading}}">
    <view class="p muted">正在加载首页内容…</view>
  </view>
  <view class="empty card" wx:elif="{{error}}">
    <view>
      <view class="h2">首页加载失败</view>
      <view class="p">{{error}}</view>
      <button class="btn btn-secondary state-button" bindtap="retry">重新加载</button>
    </view>
  </view>
  <block wx:else>
    <view class="banner card" wx:if="{{banner}}">
      <view class="p eyebrow">爆爆熊电竞</view>
      <view class="h2">{{banner.title}}</view>
      <view class="p">{{banner.subtitle}}</view>
    </view>

    <view wx:if="{{hotService}}">
      <view class="section-head">
        <view class="h2">最新服务</view>
        <view class="link" hover-class="link-hover" bindtap="goCategories">全部价目 ›</view>
      </view>
      <view
        class="service-card card {{hotService.purchasable ? '' : 'unavailable'}}"
        hover-class="card-press"
        bindtap="goDetail"
      >
        <view class="cover"><text>{{hotService.code}}</text></view>
        <view class="service-copy">
          <text class="tag">{{hotService.purchasable ? hotService.unitLabel + '计价' : '暂停接单'}}</text>
          <view class="h3">{{hotService.name}}</view>
          <view class="p">{{hotService.subtitle}}</view>
          <view class="row between">
            <text class="old-price">爆爆熊电竞</text>
            <text class="price">{{hotService.priceText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="recommended" wx:if="{{feed.length}}">
      <view class="reference-tabs" wx:if="{{tabs.length > 1}}">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="chip reference-tab {{activeFilter === item.key ? 'active' : ''}}"
          hover-class="reference-tab-hover"
          data-filter="{{item.key}}"
          bindtap="onFilter"
        >{{item.label}}</view>
      </view>
      <view class="reference-list">
        <block wx:for="{{feed}}" wx:key="id">
          <view
            wx:if="{{!item.hidden}}"
            class="reference-card {{item.purchasable ? '' : 'unavailable'}}"
            hover-class="card-press"
            data-index="{{index}}"
            bindtap="onFeedTap"
          >
            <view class="reference-cover"><text>{{item.code}}</text></view>
            <view class="reference-copy">
              <view class="h3">{{item.name}}</view>
              <view class="p"><text class="tag">{{item.purchasable ? item.groupLabel : '暂停接单'}}</text>{{item.subtitle}}</view>
              <view class="reference-price">
                <text>爆爆熊电竞</text>
                <text class="strong">{{item.priceText}}</text>
              </view>
            </view>
          </view>
        </block>
        <button
          class="btn btn-secondary load-more"
          wx:if="{{hasMore && activeFilter === 'ALL'}}"
          loading="{{loadingMore}}"
          disabled="{{loadingMore}}"
          bindtap="loadMore"
        >{{loadingMore ? '加载中…' : '加载更多'}}</button>
      </view>
    </view>

    <view class="empty card" wx:if="{{!hotService && !feed.length}}">
      <view>
        <view class="h2">暂无开放套餐</view>
        <view class="p">运营人员可在云开发控制台添加或上架服务套餐。</view>
      </view>
    </view>
  </block>
</view>

<bbx-toast id="toast" />
