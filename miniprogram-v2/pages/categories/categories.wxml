<view class="page tab-page">
  <view class="page-toolbar">
    <view class="grow"></view>
    <care-btn />
  </view>
  <view class="searchbar" hover-class="card-press" bindtap="goSearch">
    <view class="icon i-search"></view>
    <text class="muted">搜索游戏或服务</text>
  </view>
  <view class="category-shell">
    <view class="category-menu card">
      <view
        wx:for="{{games}}"
        wx:key="*this"
        class="category-item {{item === activeGame ? 'active' : ''}}"
        hover-class="row-hover"
        data-game="{{item}}"
        bindtap="switchGame"
      >{{item}}</view>
    </view>
    <view class="category-list">
      <view
        wx:for="{{cards}}"
        wx:key="code"
        class="service-card card {{item.available ? '' : 'unavailable'}}"
        hover-class="{{item.available ? 'card-press' : 'none'}}"
        data-available="{{item.available}}"
        data-index="{{index}}"
        aria-disabled="{{!item.available}}"
        bindtap="onCardTap"
      >
        <view class="cover"><text>{{item.code}}</text></view>
        <view class="service-copy">
          <text class="tag">{{item.tag}}</text>
          <view class="h3">{{item.title}}</view>
          <view class="p">{{item.note}}</view>
          <view class="row between">
            <text class="old-price" wx:if="{{item.oldPrice}}">{{item.oldPrice}}</text>
            <text class="price">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
<bbx-toast id="toast" />
