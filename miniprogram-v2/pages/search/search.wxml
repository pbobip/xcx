<view class="page">
  <view class="searchbar">
    <view class="icon i-search"></view>
    <input
      value="{{keyword}}"
      focus="{{inputFocus}}"
      placeholder="搜索铂金、钻石、娱乐陪…"
      placeholder-class="ph-paper"
      bindinput="onInput"
      bindblur="onInputBlur"
    />
    <view class="top-text" hover-class="link-hover" bindtap="onClear">清除</view>
  </view>
  <view>
    <view class="section-head">
      <view class="h2">最近搜索</view>
      <view class="link" hover-class="link-hover" bindtap="onClearRecent">清空</view>
    </view>
    <view class="chip-row">
      <view
        wx:for="{{recentKeywords}}"
        wx:key="*this"
        class="chip"
        hover-class="chip-hover"
        data-keyword="{{item}}"
        bindtap="onKeyword"
      >{{item}}</view>
    </view>
  </view>
  <view>
    <view class="section-head">
      <view class="h2">热门关键词</view>
    </view>
    <view class="chip-row">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="chip"
        hover-class="chip-hover"
        data-keyword="{{item}}"
        bindtap="onKeyword"
      >{{item}}</view>
    </view>
  </view>
  <view>
    <view class="section-head">
      <view class="h2">搜索结果</view>
      <text class="meta muted">{{count}} 项</text>
    </view>
    <view>
      <view
        wx:for="{{results}}"
        wx:key="code"
        hidden="{{item.hidden}}"
        class="service-card card"
        hover-class="card-press"
        data-index="{{index}}"
        bindtap="openDetail"
      >
        <view class="cover"><text>{{item.code}}</text></view>
        <view class="service-copy">
          <text class="tag">{{item.tag}}</text>
          <view class="h3">{{item.title}}</view>
          <view class="p">{{item.note}}</view>
          <view class="row between">
            <text class="old-price">爆爆熊电竞</text>
            <text class="price">{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty card" hidden="{{count !== 0}}">
      <view>
        <view class="empty-mark"><view class="icon i-search"></view></view>
        <view class="h2">没有找到匹配服务</view>
        <view class="p">换个段位或服务类型试试。</view>
      </view>
    </view>
  </view>
</view>
<bbx-toast id="toast" />
