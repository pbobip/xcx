<view class="page">
  <view class="searchbar">
    <view class="icon i-search"></view>
    <input
      value="{{keyword}}"
      focus="{{inputFocus}}"
      placeholder="搜索铂金、钻石、娱乐陪…"
      placeholder-class="ph-paper"
      bindinput="onInput"
      bindblur="onInputBlur"
    />
    <view class="top-text" hover-class="link-hover" bindtap="onClear">清除</view>
  </view>
  <view wx:if="{{recentKeywords.length}}">
    <view class="section-head">
      <view class="h2">最近搜索</view>
      <view class="link" hover-class="link-hover" bindtap="onClearRecent">清空</view>
    </view>
    <view class="chip-row">
      <view
        wx:for="{{recentKeywords}}"
        wx:key="*this"
        class="chip"
        hover-class="chip-hover"
        data-keyword="{{item}}"
        bindtap="onKeyword"
      >{{item}}</view>
    </view>
  </view>
  <view wx:if="{{hotKeywords.length}}">
    <view class="section-head">
      <view class="h2">热门关键词</view>
    </view>
    <view class="chip-row">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="chip"
        hover-class="chip-hover"
        data-keyword="{{item}}"
        bindtap="onKeyword"
      >{{item}}</view>
    </view>
  </view>
  <view>
    <view class="section-head">
      <view class="h2">搜索结果</view>
      <text class="meta muted">已加载 {{count}} 项</text>
    </view>
    <view class="card pad state-card" wx:if="{{loading}}">
      <view class="p muted">正在搜索云端套餐…</view>
    </view>
    <view class="empty card" wx:elif="{{error}}">
      <view>
        <view class="h2">搜索失败</view>
        <view class="p">{{error}}</view>
        <button class="btn btn-secondary state-button" bindtap="retry">重新搜索</button>
      </view>
    </view>
    <view wx:else>
      <view
        wx:for="{{results}}"
        wx:key="id"
        class="service-card card {{item.purchasable ? '' : 'unavailable'}}"
        hover-class="{{item.purchasable ? 'card-press' : 'none'}}"
        data-index="{{index}}"
        bindtap="openDetail"
      >
        <view class="cover"><text>{{item.code}}</text></view>
        <view class="service-copy">
          <text class="tag">{{item.purchasable ? item.unitLabel + '计价' : '暂停接单'}}</text>
          <view class="h3">{{item.name}}</view>
          <view class="p">{{item.subtitle}}</view>
          <view class="row between">
            <text class="old-price">爆爆熊电竞</text>
            <text class="price">{{item.priceText}}</text>
          </view>
        </view>
      </view>
      <view class="empty card" wx:if="{{count === 0}}">
        <view>
          <view class="empty-mark"><view class="icon i-search"></view></view>
          <view class="h2">没有找到匹配服务</view>
          <view class="p">换个游戏、段位或服务类型试试。</view>
        </view>
      </view>
      <button
        class="btn btn-secondary load-more"
        wx:if="{{hasMore}}"
        loading="{{loadingMore}}"
        disabled="{{loadingMore}}"
        bindtap="loadMore"
      >{{loadingMore ? '加载中…' : '加载更多'}}</button>
    </view>
  </view>
</view>
<bbx-toast id="toast" />
