<view class="page has-sticky">
  <view class="card form-card" wx:if="{{catalogLoading}}">
    <view class="p muted">正在校验服务套餐状态…</view>
  </view>
  <view class="empty card" wx:elif="{{catalogBlocked}}">
    <view>
      <view class="h2">当前套餐不可下单</view>
      <view class="p">{{error}}</view>
      <view class="btn btn-secondary" hover-class="btn-hover" bindtap="goDetail">返回套餐详情</view>
    </view>
  </view>
  <!-- 订单摘要 -->
  <view class="card form-card" wx:if="{{!catalogLoading && !catalogBlocked}}">
    <view class="service-card card" hover-class="card-press" bindtap="goDetail">
      <view class="cover"><text>{{pkg.code}}</text></view>
      <view class="service-copy">
        <text class="tag">{{pkg.label}}</text>
        <view class="h3">{{pkg.title}}</view>
        <view class="p">{{pkg.standard}}</view>
        <view class="row between"><text class="old-price">爆爆熊电竞</text><text class="price">¥{{pkg.unitPrice}}/{{pkg.unit}}</text></view>
      </view>
    </view>
    <view class="row between">
      <text>购买数量（{{pkg.unit}}）</text>
      <view class="stepper">
        <view class="step-btn" hover-class="step-btn-hover" data-step="-1" bindtap="onStep">−</view>
        <text class="out">{{qty}}</text>
        <view class="step-btn" hover-class="step-btn-hover" data-step="1" bindtap="onStep">＋</view>
      </view>
    </view>
    <view class="row between">
      <text>优惠券</text>
      <view class="top-text" hover-class="top-text-hover" bindtap="openCoupon">{{couponSummary}}</view>
    </view>
    <view class="row between">
      <text>单价</text>
      <text class="strong price">¥{{pkg.unitPrice}} / {{pkg.unit}}</text>
    </view>
  </view>

  <!-- 下单信息 -->
  <view class="card form-card" wx:if="{{!catalogLoading && !catalogBlocked}}">
    <view class="field">
      <view class="label">游戏平台{{requiredFields.platform ? ' *' : ''}}</view>
      <view class="segmented">
        <view
          wx:for="{{platformList}}"
          wx:key="*this"
          class="seg-btn {{platformIndex === index ? 'active' : ''}}"
          hover-class="seg-btn-hover"
          data-index="{{index}}"
          bindtap="onPlatformTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">游戏区服{{requiredFields.region ? ' *' : ''}}</view>
      <picker mode="selector" range="{{serverList}}" bindchange="onServerChange">
        <view class="select" hover-class="select-hover">
          <text class="{{server ? '' : 'placeholder'}}">{{serverLabel || '请选择区服'}}</text>
          <view class="icon icon-sm i-chevron"></view>
        </view>
      </picker>
    </view>
    <view class="field">
      <view class="label">游戏文字 ID{{requiredFields.gameId ? ' *' : ''}}</view>
      <input
        class="input {{idFocused ? 'focused' : ''}}"
        placeholder="仅填写游戏昵称或文字 ID"
        placeholder-class="ph-paper"
        value="{{gameId}}"
        bindinput="onIdInput"
        bindfocus="onIdFocus"
        bindblur="onIdBlur"
      />
    </view>
    <view class="field">
      <view class="label">服务时间{{requiredFields.serviceMode ? ' *' : ''}}</view>
      <view class="segmented">
        <view
          wx:for="{{timeList}}"
          wx:key="*this"
          class="seg-btn {{timeIndex === index ? 'active' : ''}}"
          hover-class="seg-btn-hover"
          data-index="{{index}}"
          bindtap="onTimeTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="field" wx:if="{{timeIndex === 1}}">
      <view class="label">预约日期和时间 *</view>
      <view class="row">
        <picker mode="date" value="{{scheduledDate}}" bindchange="onScheduledDateChange">
          <view class="select"><text class="{{scheduledDate ? '' : 'placeholder'}}">{{scheduledDate || '选择日期'}}</text></view>
        </picker>
        <picker mode="time" value="{{scheduledTime}}" bindchange="onScheduledTimeChange">
          <view class="select"><text class="{{scheduledTime ? '' : 'placeholder'}}">{{scheduledTime || '选择时间'}}</text></view>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="label">点单备注</view>
      <textarea
        class="textarea {{noteFocused ? 'focused' : ''}}"
        placeholder="可填写位置、偏好或称呼；禁止填写密码、验证码"
        placeholder-class="ph-paper"
        value="{{note}}"
        bindinput="onNoteInput"
        bindfocus="onNoteFocus"
        bindblur="onNoteBlur"
      ></textarea>
    </view>
    <view class="checkrow" hover-class="row-hover" bindtap="toggleAdult">
      <view class="checkbox {{adult ? 'checked' : ''}}"><view class="icon i-check"></view></view>
      <text>本人已成年，并已阅读换人、售后、退款与账号安全规则。</text>
    </view>
    <view class="p error">{{error}}</view>
  </view>
</view>

<!-- 底部支付操作条 -->
<view class="sticky-action">
  <view>
    <text class="muted" style="font-size:20rpx">实付金额</text>
    <text class="strong price" style="display:block">¥{{total}}</text>
  </view>
  <view
    class="btn btn-primary {{paying || catalogLoading || catalogBlocked ? 'disabled' : ''}}"
    hover-class="{{paying || catalogLoading || catalogBlocked ? 'none' : 'btn-hover'}}"
    aria-disabled="{{paying || catalogLoading || catalogBlocked}}"
    bindtap="onPay"
  >{{catalogLoading ? '正在校验套餐…' : catalogBlocked ? '当前不可下单' : paying ? '正在创建订单…' : '创建服务订单'}}</view>
</view>

<!-- 优惠券 sheet -->
<view class="modal-backdrop {{couponOpen ? 'open' : ''}}" bindtap="closeCoupon" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="h2">优惠券</view>
    <view class="p muted" style="margin:12rpx 0 28rpx">一张服务订单最多使用一张，实付金额以服务端报价为准。</view>
    <view class="p muted" wx:if="{{couponLoading}}">正在读取优惠券…</view>
    <view class="p error" wx:if="{{couponError}}">{{couponError}}</view>
    <view class="coupon-option {{selectedCouponId ? '' : 'selected'}}" hover-class="row-hover" bindtap="clearCoupon">
      <view>
        <view class="h3">不使用优惠券</view>
        <view class="p muted">按当前套餐原价结算</view>
      </view>
      <text class="link">{{selectedCouponId ? '选择' : '已选'}}</text>
    </view>
    <view
      wx:for="{{coupons}}"
      wx:for-item="coupon"
      wx:key="id"
      class="coupon-option {{coupon.available ? '' : 'disabled'}} {{selectedCouponId === coupon.id ? 'selected' : ''}}"
      hover-class="{{coupon.available ? 'row-hover' : 'none'}}"
      data-id="{{coupon.id}}"
      bindtap="selectCoupon"
    >
      <view class="coupon-option-value">
        <text class="price">{{coupon.amountText}}</text>
        <text class="p muted">{{coupon.thresholdText}}</text>
      </view>
      <view class="coupon-option-copy">
        <view class="h3">{{coupon.name}}</view>
        <view class="p">{{coupon.scopeText}} · 有效至 {{coupon.validText}}</view>
        <view class="p error" wx:if="{{!coupon.available}}">{{coupon.unavailableReason}}</view>
      </view>
      <text class="link" wx:if="{{coupon.available}}">{{selectedCouponId === coupon.id ? '已选' : '选择'}}</text>
    </view>
    <view class="p muted" wx:if="{{!couponLoading && coupons.length === 0 && !couponError}}">当前套餐暂无优惠券。</view>
    <view class="btn btn-secondary" style="width:100%;margin-top:28rpx" hover-class="btn-hover" bindtap="closeCoupon">关闭</view>
  </view>
</view>

<bbx-toast id="toast" />
