<view class="page">
  <view class="card form-card">
    <view class="field">
      <view class="label">关联订单 *</view>
      <picker mode="selector" range="{{orderList}}" bindchange="onOrderChange">
        <view class="select" hover-class="select-hover">
          <text class="{{order ? '' : 'placeholder'}}">{{order || '请选择订单'}}</text>
          <view class="icon icon-sm i-chevron select-arrow"></view>
        </view>
      </picker>
    </view>
    <view class="field">
      <view class="label">售后原因 *</view>
      <picker mode="selector" range="{{reasonList}}" bindchange="onReasonChange">
        <view class="select" hover-class="select-hover">
          <text class="{{reason ? '' : 'placeholder'}}">{{reason || '请选择原因'}}</text>
          <view class="icon icon-sm i-chevron select-arrow"></view>
        </view>
      </picker>
    </view>
    <view class="field">
      <view class="label">问题说明 *</view>
      <textarea class="textarea" placeholder="请描述发生时间、服务阶段和期望处理方式" placeholder-class="ph-paper" value="{{copy}}" bindinput="onCopyInput"></textarea>
    </view>
    <view class="upload" hover-class="upload-hover" bindtap="onUpload">＋ 添加必要图片凭证</view>
    <view class="evidence-grid" wx:if="{{evidence.length}}">
      <view class="evidence-item" wx:for="{{evidence}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="evidence-remove" data-index="{{index}}" bindtap="onRemoveEvidence">×</view>
      </view>
    </view>
    <view class="error">{{error}}</view>
    <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" hover-class="{{submitting ? 'none' : 'btn-hover'}}" bindtap="onSubmit">{{submitting ? '正在提交…' : '提交售后'}}</view>
  </view>
</view>
<bbx-toast id="toast" />
