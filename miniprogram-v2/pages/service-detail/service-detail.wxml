<view class="has-sticky">
  <view class="page" wx:if="{{loading}}">
    <view class="card pad state-card"><view class="p muted">正在加载套餐详情…</view></view>
  </view>
  <view class="page" wx:elif="{{error}}">
    <view class="empty card">
      <view>
        <view class="h2">套餐详情加载失败</view>
        <view class="p">{{error}}</view>
        <button class="btn btn-secondary state-button" bindtap="retry">重新加载</button>
      </view>
    </view>
  </view>
  <block wx:elif="{{service}}">
    <view class="hero-cover">
      <view class="cover"><text>{{service.code}}</text></view>
    </view>
    <view class="page">
      <view class="card">
        <view class="detail-block">
          <text class="tag">{{service.purchasable ? service.unitLabel + '计价' : '暂停接单'}}</text>
          <view class="h2 detail-title">{{service.name}}</view>
          <view class="p muted">{{service.subtitle}}</view>
          <view class="row between detail-price-row">
            <text class="old-price" wx:if="{{originalPriceText}}">原价 {{originalPriceText}}</text>
            <text class="price">{{priceText}}</text>
          </view>
        </view>
        <view class="detail-block">
          <view class="h2">支持平台与区服</view>
          <view class="chip-row">
            <text class="chip" wx:for="{{service.platforms}}" wx:key="*this">{{item}}</text>
            <text class="chip" wx:for="{{service.regions}}" wx:key="code" wx:if="{{item.status === 'ACTIVE'}}">{{item.name}}</text>
          </view>
        </view>
        <view class="detail-block">
          <view class="h2">履约标准</view>
          <view class="p notice">{{service.fulfillmentStandard}}</view>
        </view>
        <view class="detail-block">
          <view class="h2">下单须知</view>
          <view class="p notice">{{service.purchaseNotice}}</view>
        </view>
        <view class="detail-block" wx:if="{{service.descriptionBlocks.length}}">
          <view class="h2">服务详情</view>
          <view class="stack">
            <view class="card-2 pad" wx:for="{{service.descriptionBlocks}}" wx:key="title">
              <view class="h3">{{item.title}}</view>
              <view class="p muted">{{item.content}}</view>
            </view>
          </view>
        </view>
        <view class="detail-block">
          <view class="h2">真实服务数据</view>
          <view class="metric-row">
            <view class="metric"><text class="strong">{{service.stats.overallScore || '—'}}</text><text>综合评分</text></view>
            <view class="metric"><text class="strong">{{service.stats.orderCount}}</text><text>累计接单</text></view>
            <view class="metric"><text class="strong">{{service.stats.reviewCount}}</text><text>真实评价</text></view>
          </view>
          <view class="p muted stats-note">销量、评分与评价仅由真实完成订单生成。</view>
        </view>
        <view class="detail-block">
          <view class="h2">安全提示</view>
          <view class="p notice">仅限成年人下单；请勿填写账号密码、验证码或支付凭证。</view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="sticky-action service-actions">
  <button class="btn btn-secondary contact-button" hover-class="sticky-btn-hover" open-type="contact">联系客服</button>
  <view
    class="btn btn-primary {{service && service.purchasable ? '' : 'disabled'}}"
    hover-class="sticky-btn-hover"
    aria-disabled="{{!service || !service.purchasable}}"
    bindtap="onChoosePlan"
  >{{service && !service.purchasable ? '暂停接单' : '选择套餐'}}</view>
</view>

<bbx-toast id="toast" />
